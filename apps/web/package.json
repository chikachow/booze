{
  "name": "@chikachow/booze-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "astryx": "pnpm exec astryx",
    "build": "WRANGLER_WRITE_LOGS=false vite build && pnpm run bundle:check",
    "bundle:check": "node scripts/check-client-bundle.mjs",
    "deploy": "pnpm run build && WRANGLER_WRITE_LOGS=false wrangler deploy",
    "dev": "WRANGLER_WRITE_LOGS=false vite dev",
    "preview": "vite preview",
    "test": "node --test --enable-source-maps worker/*.test.ts scripts/*.test.mjs && vitest run && pnpm run theme:check && pnpm run test:browser",
    "test:browser": "playwright test",
    "theme:build": "pnpm astryx theme build src/booze-theme.ts --out src/generated/booze.css",
    "theme:check": "node scripts/check-theme.mjs",
    "typecheck": "tsc --noEmit",
    "wrangler:types": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@astryxdesign/core": "0.3.0",
    "@astryxdesign/theme-neutral": "0.3.0",
    "@chikachow/booze-db": "workspace:*",
    "@clerk/backend": "3.16.10",
    "@clerk/react": "6.14.5",
    "@fontsource-variable/figtree": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@stylexjs/stylex": "0.19.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.3.0",
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "5.20260819.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.13.0",
    "gpt-tokenizer": "4.0.0",
    "jsdom": "30.0.1",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.124.0"
  }
}
