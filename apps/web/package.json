{
  "name": "@chikachow/booze-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "astryx": "pnpm exec astryx",
    "build": "WRANGLER_WRITE_LOGS=false vite build && pnpm run bundle:check",
    "bundle:check": "node scripts/check-client-bundle.mjs",
    "deploy": "pnpm run build && WRANGLER_WRITE_LOGS=false wrangler deploy",
    "dev": "WRANGLER_WRITE_LOGS=false vite dev",
    "preview": "vite preview",
    "test": "node --test --enable-source-maps worker/*.test.ts scripts/*.test.mjs && vitest run && pnpm run theme:check && pnpm run test:browser",
    "test:browser": "playwright test",
    "theme:build": "pnpm astryx theme build src/booze-theme.ts --out src/generated/booze.css",
    "theme:check": "node scripts/check-theme.mjs",
    "typecheck": "tsc --noEmit",
    "wrangler:types": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.0",
    "@astryxdesign/theme-neutral": "0.7.0",
    "@chikachow/booze-db": "workspace:*",
    "@clerk/backend": "3.23.2",
    "@clerk/react": "6.17.8",
    "@fontsource-variable/figtree": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@stylexjs/stylex": "0.19.1",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.0",
    "@cloudflare/vite-plugin": "1.63.2",
    "@cloudflare/workers-types": "5.20261013.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  }
}
