    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "react": "19.2.8",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.39.0",
    "@cloudflare/workers-types": "5.20260723.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.16",
    "wrangler": "4.95.0"
  }
