{
  "name": "@chikachow/booze-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "WRANGLER_WRITE_LOGS=false vite build",
    "deploy": "WRANGLER_WRITE_LOGS=false vite build && WRANGLER_WRITE_LOGS=false wrangler deploy",
    "dev": "WRANGLER_WRITE_LOGS=false vite dev",
