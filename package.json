{
  "name": "@chikachow/booze",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --run lockfile:check && node --run peer-dependencies:check && node --run dedupe:check && node --run format:check && node --run lint && node --run typecheck && node --run test",
    "dedupe:check": "pnpm dedupe --check --ignore-scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "lockfile:check": "pnpm install --lockfile-only --frozen-lockfile",
    "peer-dependencies:check": "pnpm install --resolution-only --strict-peer-dependencies --no-frozen-lockfile --ignore-scripts",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/recommended": "1.0.13",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.33.4"
}
